# Environment Configuration Template

# Application Settings
APP_URL=http://localhost/DiaryApp/index.php
APP_SECRET=change_me_to_a_random_secret_key_32_chars_or_more

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=diary_app

# File Upload Settings
UPLOAD_PATH=storage/uploads
TEMP_UPLOAD_PATH=storage/temp_uploads
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# Session Configuration
SESSION_LIFETIME=3600

# Email / SMTP Configuration (for OTP verification)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USER=your_email@example.com
MAIL_PASS=your_password
MAIL_FROM=noreply@diaryapp.local
